# Server-only, never put provider keys in VITE_* variables.
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing
BAILIAN_AGENT_ID=
BAILIAN_ENVIRONMENT_ID=
BAILIAN_AGENT_VERSION=11
AMAP_MAPS_API_KEY=
TRAVEL_DATA_MODE=live
TRAVEL_API_PORT=3001
AGENT_TIMEOUT_MS=180000
# Optional: FLYAI_API_KEY; otherwise official CLI reads the existing local FlyAI config.

# Optional dedicated Node executable for FlyAI only. Use an absolute path.
# Windows verification: Node 24.20.0; version mismatch fails instead of falling back.
FLYAI_NODE_PATH=
FLYAI_NODE_VERSION=
